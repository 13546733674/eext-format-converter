! Minimal padstack library for tests
.PAD "SMD_Rect_150x130"
..RECTANGLE
...WIDTH 1.5
...HEIGHT 1.3

.PAD "SMD_Rect_150x130_SM"
..RECTANGLE
...WIDTH 1.7
...HEIGHT 1.5

.PAD "SMD_Rect_150x130_SP"
..RECTANGLE
...WIDTH 1.5
...HEIGHT 1.3

.PAD "Round_1mm"
..ROUND
...DIAMETER 1.0

.HOLE "Round_1mm"
..ROUND
...DIAMETER 0.8
..HOLE_OPTIONS PLATED

.PADSTACK "SR150X130"
..PADSTACK_TYPE PIN_SMD
..TECHNOLOGY
...TOP_PAD "SMD_Rect_150x130"
...BOTTOM_PAD "SMD_Rect_150x130"
...TOP_SOLDERMASK_PAD "SMD_Rect_150x130_SM"
...BOTTOM_SOLDERMASK_PAD "SMD_Rect_150x130_SM"
...TOP_SOLDERPASTE_PAD "SMD_Rect_150x130_SP"
...BOTTOM_SOLDERPASTE_PAD "SMD_Rect_150x130_SP"

.PADSTACK "TH_1mm"
..PADSTACK_TYPE PIN_THROUGH
..TECHNOLOGY
...TOP_PAD "Round_1mm"
...BOTTOM_PAD "Round_1mm"
...TOP_SOLDERMASK_PAD "Round_1mm"
...BOTTOM_SOLDERMASK_PAD "Round_1mm"
...HOLE_NAME "Round_1mm"
